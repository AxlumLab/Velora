<Page x:Class="Consumer.Hello"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock x:Name="Greeting" Text="{x:Bind Name, Mode=OneWay}"/>
    <Button x:Name="Greet" Content="Greet" Click="OnGreet"/>
  </StackPanel>
</Page>
