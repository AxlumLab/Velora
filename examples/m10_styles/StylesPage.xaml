<Page x:Class="M10.StylesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource PageBackground}">
  <Page.Resources>
    <ResourceDictionary>
      <!-- WinUI 2.3 Button and TextBox styles: implicit styles for every Button and TextBox here. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="WinUIButton.xaml"/>
        <ResourceDictionary Source="WinUITextBox.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBackground" Color="#FFF3F3F3"/>
          <SolidColorBrush x:Key="CardBackground" Color="{ThemeResource SystemAltHighColor}"/>
          <Color x:Key="PillHover">#FF005A9E</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBackground" Color="#FF202020"/>
          <SolidColorBrush x:Key="CardBackground" Color="#FF2D2D2D"/>
          <Color x:Key="PillHover">#FF429CE3</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style x:Key="TitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
      </Style>
      <Style x:Key="SubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleStyle}">
        <Setter Property="FontSize" Value="15"/>
      </Style>

      <!-- A custom Button template: its own visuals, states and eased animations. -->
      <ControlTemplate x:Key="PillTemplate" TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal"/>
              <VisualState x:Name="PointerOver">
                <Storyboard>
                  <ColorAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                  To="{ThemeResource PillHover}" Duration="0:0:0.2">
                    <ColorAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut"/>
                    </ColorAnimation.EasingFunction>
                  </ColorAnimation>
                </Storyboard>
              </VisualState>
              <VisualState x:Name="Pressed">
                <VisualState.Setters>
                  <Setter Target="Label.Foreground" Value="#FFFFE680"/>
                </VisualState.Setters>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.1"/>
                </Storyboard>
              </VisualState>
              <VisualState x:Name="Disabled">
                <VisualState.Setters>
                  <Setter Target="Chrome.Opacity" Value="0.4"/>
                </VisualState.Setters>
              </VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <ContentPresenter x:Name="Label" Foreground="White"/>
        </Border>
      </ControlTemplate>
      <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}"/>
        <Setter Property="Padding" Value="18,6,18,6"/>
        <Setter Property="Template" Value="{StaticResource PillTemplate}"/>
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <StackPanel Margin="24" Spacing="14">
    <TextBlock x:Name="Title" Text="Styles, templates and themes" Style="{StaticResource TitleStyle}"/>
    <TextBlock x:Name="Subtitle" Text="WinUI 2.3 Button and TextBox styles, a custom ControlTemplate, ThemeResource" Style="{StaticResource SubtitleStyle}"/>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button x:Name="DefaultButton" Content="WinUI default" Click="OnDefault"/>
      <Button x:Name="PillA" Content="Pill A" Style="{StaticResource PillButtonStyle}" Click="OnPillA"/>
      <Button x:Name="PillB" Content="Pill B" Style="{StaticResource PillButtonStyle}" Click="OnPillB"/>
      <Button x:Name="ThemeButton" Content="Toggle theme" Click="OnToggleTheme"/>
    </StackPanel>
    <TextBox x:Name="Input" PlaceholderText="WinUI TextBox style" Width="320" HorizontalAlignment="Left"/>
    <Border x:Name="Card" Background="{ThemeResource CardBackground}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12">
      <TextBlock x:Name="CardText" Text="ThemeResource values follow the theme" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
    </Border>
  </StackPanel>
</Page>
