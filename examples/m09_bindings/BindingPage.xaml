<Page x:Class="M09.Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:M09"
      Background="#FFF3F3F3">
  <Grid Margin="20" RowSpacing="12" ColumnSpacing="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <!-- The details column scrolls when the window is too short for it. -->
    <ScrollViewer x:Name="Details" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <!-- x:Bind with change notification: no update_bindings() call is needed. -->
        <TextBox x:Name="QueryBox" PlaceholderText="Search" Text="{x:Bind Model.Query, Mode=TwoWay}"/>
        <TextBlock x:Name="SummaryText" Text="{x:Bind Model.Summary, Mode=OneWay}"/>
        <TextBlock x:Name="SelectedName" Text="{x:Bind Model.Selected.Name, Mode=OneWay}" FontSize="18"/>
        <!-- {Binding} against a DataContext that switches when Model.Selected changes. -->
        <Border x:Name="Card" DataContext="{x:Bind Model.Selected, Mode=OneWay}" Background="White"
                BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="6" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock x:Name="CardName" Text="{Binding Name}"/>
            <TextBlock x:Name="CardAge" Text="{Binding Age}"/>
            <TextBox x:Name="CardEdit" Text="{Binding Name, Mode=TwoWay}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ListView x:Name="People" Grid.Column="1" ItemsSource="{x:Bind Model.People}" ItemHeight="32"
              Background="White" BorderBrush="#FFD0D0D0" BorderThickness="1">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:Person">
          <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,4,8,4">
            <TextBlock x:Name="Label" Text="{x:Bind Name, Mode=OneWay}" Width="120" VerticalAlignment="Center"/>
            <TextBlock x:Name="AgeText" Text="{Binding Age}" Width="40" VerticalAlignment="Center"/>
            <Button x:Name="RemoveButton" Content="Remove" Click="Remove" Padding="8,2,8,2"/>
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
