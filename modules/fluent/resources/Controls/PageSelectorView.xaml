     Velora paging presentation based on WinUI 2.3 Pivot/FlipView theme inputs. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.PageSelectorView"
      RowDefinitions="Auto,Auto,*" RowSpacing="8">
    <TextBlock x:Name="TitleText" FontSize="20"/>
    <StackPanel x:Name="Headers" Grid.Row="1" Orientation="Horizontal" Spacing="8"/>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Button x:Name="PreviousButton" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Width="32" IsTabStop="False"/>
        <Grid x:Name="PageHost" Grid.Column="1"/>
        <Button x:Name="NextButton" Grid.Column="2" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Width="32" IsTabStop="False"/>
    </Grid>
</Grid>
