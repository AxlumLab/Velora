<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.DropDownButtonView" x:Name="RootGrid">
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx-framework:///Themes/FlyoutButtonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Grid.Resources>
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="FlyoutStates">
            <VisualState x:Name="FlyoutClosed"/>
            <VisualState x:Name="FlyoutOpen">
                <VisualState.Setters>
                    <Setter Target="PrimaryButton.Background" Value="{ThemeResource ButtonBackgroundPressed}"/>
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Button x:Name="PrimaryButton" MinWidth="100" MinHeight="32" IsTabStop="False"/>
</Grid>
