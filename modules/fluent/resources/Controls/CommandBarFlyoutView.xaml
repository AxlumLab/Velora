<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.CommandBarFlyoutView"
            MinWidth="200" Spacing="4">
    <Grid ColumnDefinitions="*,Auto">
        <StackPanel x:Name="PrimaryCommands" Orientation="Horizontal"/>
        <Button x:Name="MoreButton" Grid.Column="1" Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                FontSize="20" Width="48" MinHeight="48"/>
    </Grid>
    <StackPanel x:Name="SecondaryCommands"/>
</StackPanel>
