<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.DateTimePickerView" Spacing="4">
    <TextBlock x:Name="HeaderContentPresenter"/>
    <Button x:Name="FlyoutButton" MinWidth="220" MinHeight="36" Padding="12,6" IsTabStop="False">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*,24" ColumnSpacing="12">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Button.Template>
    </Button>
</StackPanel>
