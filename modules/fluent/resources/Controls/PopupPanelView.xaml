<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.PopupPanelView"
            MinWidth="280" Width="360" Margin="16" Spacing="12">
    <TextBlock x:Name="TitleText" FontSize="20"/>
    <TextBlock x:Name="SubtitleText" FontSize="14"/>
    <TextBlock x:Name="BodyText" FontSize="14"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="PrimaryButton" MinWidth="80"/>
        <Button x:Name="SecondaryButton" MinWidth="80"/>
        <Button x:Name="CloseButton" MinWidth="80"/>
    </StackPanel>
</StackPanel>
