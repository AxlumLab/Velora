     Internal Velora rewrite of WinUI 2.3 PersonPicture.xaml. Ellipses use rounded Borders;
     Windows glyphs use the installed Segoe MDL2 Assets font. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.PersonPictureView" x:Name="RootGrid">
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx-framework:///Themes/PersonPictureResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Grid.Resources>
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Initials">
                <VisualState.Setters>
                    <Setter Target="InitialsTextBlock.Visibility" Value="Visible"/>
                    <Setter Target="ProfileImage.Visibility" Value="Collapsed"/>
                    <Setter Target="SingleIcon.Visibility" Value="Collapsed"/>
                    <Setter Target="GroupIcon.Visibility" Value="Collapsed"/>
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Photo">
                <VisualState.Setters>
                    <Setter Target="InitialsTextBlock.Visibility" Value="Collapsed"/>
                    <Setter Target="ProfileImage.Visibility" Value="Visible"/>
                    <Setter Target="SingleIcon.Visibility" Value="Collapsed"/>
                    <Setter Target="GroupIcon.Visibility" Value="Collapsed"/>
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="NoPhotoOrInitials">
                <VisualState.Setters>
                    <Setter Target="InitialsTextBlock.Visibility" Value="Collapsed"/>
                    <Setter Target="ProfileImage.Visibility" Value="Collapsed"/>
                    <Setter Target="SingleIcon.Visibility" Value="Visible"/>
                    <Setter Target="GroupIcon.Visibility" Value="Collapsed"/>
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Group">
                <VisualState.Setters>
                    <Setter Target="InitialsTextBlock.Visibility" Value="Collapsed"/>
                    <Setter Target="ProfileImage.Visibility" Value="Collapsed"/>
                    <Setter Target="SingleIcon.Visibility" Value="Collapsed"/>
                    <Setter Target="GroupIcon.Visibility" Value="Visible"/>
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="BadgeStates">
            <VisualState x:Name="NoBadge">
                <VisualState.Setters><Setter Target="BadgeGrid.Visibility" Value="Collapsed"/></VisualState.Setters>
            </VisualState>
            <VisualState x:Name="BadgeWithoutImageSource">
                <VisualState.Setters>
                    <Setter Target="BadgeGrid.Visibility" Value="Visible"/>
                    <Setter Target="BadgeImage.Visibility" Value="Collapsed"/>
                    <Setter Target="BadgeNumberTextBlock.Visibility" Value="Visible"/>
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="BadgeWithImageSource">
                <VisualState.Setters>
                    <Setter Target="BadgeGrid.Visibility" Value="Visible"/>
                    <Setter Target="BadgeImage.Visibility" Value="Visible"/>
                    <Setter Target="BadgeNumberTextBlock.Visibility" Value="Collapsed"/>
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Border x:Name="AvatarCircle" CornerRadius="50"
            BorderThickness="{ThemeResource PersonPictureBorderThickness}"
            BorderBrush="{ThemeResource PersonPictureStroke}"
            Background="{ThemeResource PersonPictureEllipseFillThemeBrush}">
        <Image x:Name="ProfileImage" Stretch="UniformToFill"/>
    </Border>
    <TextBlock x:Name="InitialsTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="42" Foreground="{ThemeResource PersonPictureForegroundThemeBrush}"/>
    <TextBlock x:Name="SingleIcon" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="42"
               Foreground="{ThemeResource PersonPictureForegroundThemeBrush}"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <TextBlock x:Name="GroupIcon" Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="42"
               Foreground="{ThemeResource PersonPictureForegroundThemeBrush}"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Grid x:Name="BadgeGrid" Width="50" Height="50" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Border x:Name="BadgeCircle" CornerRadius="25" BorderThickness="2"
                BorderBrush="{ThemeResource PersonPictureEllipseBadgeStrokeThemeBrush}"
                Background="{ThemeResource PersonPictureEllipseBadgeFillThemeBrush}">
            <Image x:Name="BadgeImage" Stretch="UniformToFill"/>
        </Border>
        <TextBlock x:Name="BadgeNumberTextBlock" FontSize="30"
                   Foreground="{ThemeResource PersonPictureEllipseBadgeForegroundThemeBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Grid>
