     Adapted from WinUI 2.3 DatePicker/TimePicker presenter fields and accept/dismiss hosts.
     Velora uses finite button steppers until a looping selector is implemented. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.DateTimePickerFlyoutView"
            Width="300" Margin="12" Spacing="12">
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <StackPanel x:Name="Field0" Grid.Column="0" Spacing="8">
            <TextBlock x:Name="Label0" HorizontalAlignment="Center"/>
            <Button x:Name="Increase0" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Height="32"/>
            <TextBlock x:Name="Value0" FontSize="24" HorizontalAlignment="Center"/>
            <Button x:Name="Decrease0" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Height="32"/>
        </StackPanel>
        <StackPanel x:Name="Field1" Grid.Column="1" Spacing="8">
            <TextBlock x:Name="Label1" HorizontalAlignment="Center"/>
            <Button x:Name="Increase1" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Height="32"/>
            <TextBlock x:Name="Value1" FontSize="24" HorizontalAlignment="Center"/>
            <Button x:Name="Decrease1" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Height="32"/>
        </StackPanel>
        <StackPanel x:Name="Field2" Grid.Column="2" Spacing="8">
            <TextBlock x:Name="Label2" HorizontalAlignment="Center"/>
            <Button x:Name="Increase2" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Height="32"/>
            <TextBlock x:Name="Value2" FontSize="24" HorizontalAlignment="Center"/>
            <Button x:Name="Decrease2" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Height="32"/>
        </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <Button x:Name="AcceptButton" Content="&#xE73E;" FontFamily="Segoe MDL2 Assets" Height="36"/>
        <Button x:Name="DismissButton" Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Height="36"/>
    </Grid>
</StackPanel>
