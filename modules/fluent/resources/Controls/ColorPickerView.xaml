<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.ColorPickerView" Width="280" Spacing="6">
    <Border x:Name="Preview" Height="24"/>
    <Border x:Name="SpectrumHost" Height="140"/>
    <StackPanel x:Name="ChannelRow0" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="R" Width="20" VerticalAlignment="Center"/>
        <Slider x:Name="Channel0" Minimum="0" Maximum="255" StepFrequency="1" Width="248"/>
    </StackPanel>
    <StackPanel x:Name="ChannelRow1" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="G" Width="20" VerticalAlignment="Center"/>
        <Slider x:Name="Channel1" Minimum="0" Maximum="255" StepFrequency="1" Width="248"/>
    </StackPanel>
    <StackPanel x:Name="ChannelRow2" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="B" Width="20" VerticalAlignment="Center"/>
        <Slider x:Name="Channel2" Minimum="0" Maximum="255" StepFrequency="1" Width="248"/>
    </StackPanel>
    <StackPanel x:Name="ChannelRow3" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="A" Width="20" VerticalAlignment="Center"/>
        <Slider x:Name="Channel3" Minimum="0" Maximum="255" StepFrequency="1" Width="248"/>
    </StackPanel>
    <StackPanel x:Name="ChannelRow4" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="V" Width="20" VerticalAlignment="Center"/>
        <Slider x:Name="Channel4" Minimum="0" Maximum="100" StepFrequency="1" Width="248"/>
    </StackPanel>
    <TextBox x:Name="HexTextBox"/>
    <TextBlock x:Name="ErrorText" Foreground="#FFB00020" FontSize="12"/>
</StackPanel>
