<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.CommandBarView"
      ColumnDefinitions="*,Auto" MinHeight="48">
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx-framework:///Themes/FlyoutButtonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Grid.Resources>
    <StackPanel x:Name="PrimaryCommands" Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left"/>
    <StackPanel x:Name="OverflowStorage" Visibility="Collapsed"/>
    <Button x:Name="MoreButton" Grid.Column="1" Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
            FontSize="20" Width="48" MinHeight="48" Padding="8" VerticalAlignment="Center"/>
</Grid>
