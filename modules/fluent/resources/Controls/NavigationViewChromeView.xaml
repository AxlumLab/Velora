     Shared navigation toggle/back/title strip for Velora NavigationView. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.NavigationViewChromeView"
      ColumnDefinitions="Auto,Auto,*" Height="40">
    <Button x:Name="PaneToggleButton" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Width="40" FontSize="16"/>
    <Button x:Name="BackButton" Grid.Column="1" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Width="40" FontSize="16"/>
    <TextBlock x:Name="PaneTitleText" Grid.Column="2" Margin="8,0" FontSize="16" VerticalAlignment="Center"/>
</Grid>
