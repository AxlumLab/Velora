<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.NumberBoxView"
      RowDefinitions="Auto,Auto" RowSpacing="6" MinWidth="180">
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx-framework:///Themes/WinUITextBox.xaml"/>
                <ResourceDictionary Source="ms-appx-framework:///Themes/WinUIButton.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Grid.Resources>
    <TextBlock x:Name="HeaderContentPresenter" FontSize="14" Foreground="{ThemeResource TextControlForeground}"/>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="2">
        <TextBox x:Name="InputBox" MinWidth="100"/>
        <StackPanel x:Name="SpinButtons" Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button x:Name="DownSpinButton" Content="−" Width="32" Padding="0" IsTabStop="False"/>
            <Button x:Name="UpSpinButton" Content="+" Width="32" Padding="0" IsTabStop="False"/>
        </StackPanel>
    </Grid>
</Grid>
