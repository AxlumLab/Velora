<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.AutoSuggestBoxView"
      RowDefinitions="Auto,Auto" RowSpacing="4">
    <TextBlock x:Name="HeaderText" FontSize="14"/>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="2">
        <TextBox x:Name="TextBox" MinWidth="180"/>
        <Button x:Name="QueryButton" Grid.Column="1" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="36" IsTabStop="False"/>
    </Grid>
</Grid>
