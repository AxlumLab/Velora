<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="velora.PaneLayoutView">
    <Canvas.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx-framework:///Themes/FlyoutButtonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Canvas.Resources>
    <Border x:Name="Pane1Host"/>
    <Border x:Name="DismissOverlay" Background="#33000000" Visibility="Collapsed"/>
    <Border x:Name="Pane2Host" Background="{ThemeResource FlyoutPresenterBackground}"/>
</Canvas>
