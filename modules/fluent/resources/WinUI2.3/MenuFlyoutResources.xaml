<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#FF454545"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#FF666666"/>
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#FF767676"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FF000000"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#FFE5E5E5"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#FFCCCCCC"/>
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#FF767676"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#FF000080"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#FF000080"/>
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#FFFFFFFF"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
