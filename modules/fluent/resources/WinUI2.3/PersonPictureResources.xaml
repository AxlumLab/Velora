     Derived from WinUI 2.3 dev/PersonPicture/PersonPicture_themeresources.xaml.
     Platform-only system colors are explicit Velora palette values; scalar ellipse stroke
     thickness is represented as Border Thickness. See modules/fluent/PORTING.md. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SystemResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PersonPictureForegroundThemeBrush" Color="{StaticResource SystemAltHighColor}"/>
            <SolidColorBrush x:Key="PersonPictureEllipseFillThemeBrush" Color="{StaticResource SystemBaseMediumColor}"/>
            <SolidColorBrush x:Key="PersonPictureEllipseBadgeForegroundThemeBrush" Color="{StaticResource SystemBaseHighColor}"/>
            <SolidColorBrush x:Key="PersonPictureEllipseBadgeFillThemeBrush" Color="#FF333333"/>
            <SolidColorBrush x:Key="PersonPictureEllipseBadgeStrokeThemeBrush" Color="#66FFFFFF"/>
            <SolidColorBrush x:Key="PersonPictureStroke" Color="Transparent"/>
            <Thickness x:Key="PersonPictureBorderThickness">0</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PersonPictureForegroundThemeBrush" Color="{StaticResource SystemAltHighColor}"/>
            <SolidColorBrush x:Key="PersonPictureEllipseFillThemeBrush" Color="{StaticResource SystemBaseMediumColor}"/>
            <SolidColorBrush x:Key="PersonPictureEllipseBadgeForegroundThemeBrush" Color="{StaticResource SystemBaseHighColor}"/>
            <SolidColorBrush x:Key="PersonPictureEllipseBadgeFillThemeBrush" Color="#FFCCCCCC"/>
            <SolidColorBrush x:Key="PersonPictureEllipseBadgeStrokeThemeBrush" Color="#66000000"/>
            <SolidColorBrush x:Key="PersonPictureStroke" Color="Transparent"/>
            <Thickness x:Key="PersonPictureBorderThickness">0</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PersonPictureForegroundThemeBrush" Color="White"/>
            <SolidColorBrush x:Key="PersonPictureEllipseFillThemeBrush" Color="Black"/>
            <SolidColorBrush x:Key="PersonPictureEllipseBadgeForegroundThemeBrush" Color="White"/>
            <SolidColorBrush x:Key="PersonPictureEllipseBadgeFillThemeBrush" Color="Black"/>
            <SolidColorBrush x:Key="PersonPictureEllipseBadgeStrokeThemeBrush" Color="White"/>
            <SolidColorBrush x:Key="PersonPictureStroke" Color="White"/>
            <Thickness x:Key="PersonPictureBorderThickness">1</Thickness>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
