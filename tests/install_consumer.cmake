# Installs the build tree into WORK_DIR/install and builds and runs examples/consumer against
# it with find_package(Velora). Inputs: BUILD_DIR, SOURCE_DIR, WORK_DIR, CONFIG, RHODIUM_DIR, MAKE_PROGRAM.
set(ROOT_DIR "${BUILD_DIR}")
file(REAL_PATH "${ROOT_DIR}" _root)
file(REAL_PATH "${WORK_DIR}" _work)
string(FIND "${_work}/" "${_root}/" _inside)
if(NOT _inside EQUAL 0 OR _work STREQUAL _root)
    message(FATAL_ERROR "Test workspace must be a child of ROOT_DIR: ${_work}")
endif()
file(REMOVE_RECURSE "${_work}")
function(run step)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${step} failed:\n${out}")
    endif()
    message(STATUS "${step}: ok")
endfunction()
run("install" "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}" --prefix "${WORK_DIR}/install")
set(args -G "${GENERATOR}" "-DCMAKE_BUILD_TYPE=${CONFIG}"
    "-DCMAKE_PREFIX_PATH=${WORK_DIR}/install" "-Drhodium_DIR=${RHODIUM_DIR}"
    "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}")
if(GENERATOR MATCHES "Visual Studio")
    list(APPEND args -A "${GENERATOR_PLATFORM}" "-DCMAKE_CONFIGURATION_TYPES=${CONFIG}")
    set(consumer "${WORK_DIR}/build/${CONFIG}/velora_consumer.exe")
else()
    list(APPEND args "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
    set(consumer "${WORK_DIR}/build/velora_consumer${CMAKE_EXECUTABLE_SUFFIX}")
    if(WIN32)
        set(consumer "${consumer}.exe")
    endif()
endif()
run("configure consumer" "${CMAKE_COMMAND}" -S "${SOURCE_DIR}/examples/consumer" -B "${WORK_DIR}/build" ${args})
run("build consumer" "${CMAKE_COMMAND}" --build "${WORK_DIR}/build" --config "${CONFIG}")
run("run consumer" "${consumer}")
