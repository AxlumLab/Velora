<Page x:Class="Test.Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Surface" Color="White"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Surface" Color="#FF202020"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StaticResource x:Key="Fixed" ResourceKey="Surface"/>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
      </Style>
      <Style x:Key="Base" TargetType="Button">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Background" Value="{ThemeResource Surface}"/>
      </Style>
      <Style x:Key="Fancy" TargetType="Button" BasedOn="{StaticResource Base}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Chrome.Background" Value="{ThemeResource InkBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity">
                          <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0.8"/>
                          <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.5">
                            <EasingDoubleKeyFrame.EasingFunction>
                              <SineEase EasingMode="EaseInOut"/>
                            </EasingDoubleKeyFrame.EasingFunction>
                          </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Text" Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="Red"/>
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="Text"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Page.Resources>
  <StackPanel Background="{StaticResource Fixed}">
    <TextBlock x:Name="Body" Text="Body"/>
    <Button x:Name="Go" Content="Go" Style="{StaticResource Fancy}" Click="OnClick"/>
    <Button Content="Plain" Style="{StaticResource Base}" Padding="2"/>
  </StackPanel>
</Page>
