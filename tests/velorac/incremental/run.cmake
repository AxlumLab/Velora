# Verifies that editing one XAML file regenerates only the views that depend on it, and that
# velorac leaves unchanged outputs untouched so their C++ is not recompiled.
# Inputs: SOURCE_DIR, WORK_DIR, VELORAC, VELORA_CMAKE_DIR, MAKE_PROGRAM.
file(REAL_PATH "${ROOT_DIR}" _root)
file(REAL_PATH "${WORK_DIR}" _work)
string(FIND "${_work}/" "${_root}/" _inside)
if(NOT _inside EQUAL 0 OR _work STREQUAL _root)
    message(FATAL_ERROR "Test workspace must be a child of ROOT_DIR: ${_work}")
endif()
file(REMOVE_RECURSE "${_work}")
file(COPY "${SOURCE_DIR}/" DESTINATION "${WORK_DIR}/src" PATTERN "run.cmake" EXCLUDE)
execute_process(
    COMMAND "${CMAKE_COMMAND}" -S "${WORK_DIR}/src" -B "${WORK_DIR}/build" -G Ninja
        "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}" "-DVELORAC_EXECUTABLE=${VELORAC}" "-DVELORA_CMAKE_DIR=${VELORA_CMAKE_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE out)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "configure failed:\n${out}")
endif()

set(out_dir "${WORK_DIR}/build/xaml/views")
set(outputs Chip.g.cpp Chip.g.hpp Main.g.cpp Main.g.hpp Other.g.cpp Other.g.hpp)
function(stamps var)
    set(list "")
    foreach(f IN LISTS outputs)
        file(TIMESTAMP "${out_dir}/${f}" t "%Y-%m-%dT%H:%M:%S.%f")
        list(APPEND list "${t}")
    endforeach()
    set(${var} "${list}" PARENT_SCOPE)
endfunction()

# Builds, then compares the velorac commands that ran and the outputs that were rewritten.
function(build_step name expected_ran expected_written)
    stamps(before)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK_DIR}/build"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${name}: build failed:\n${out}")
    endif()
    stamps(after)
    string(REGEX MATCHALL "velorac [A-Za-z]+\\.xaml" ran "${out}")
    list(TRANSFORM ran REPLACE "velorac " "")
    list(SORT ran)
    string(REPLACE ";" "," ran_text "${ran}")
    set(written "")
    foreach(i RANGE 5)
        list(GET before ${i} b)
        list(GET after ${i} a)
        if(NOT a STREQUAL b)
            list(GET outputs ${i} f)
            list(APPEND written "${f}")
        endif()
    endforeach()
    string(REPLACE ";" "," written_text "${written}")
    if(NOT ran_text STREQUAL "${expected_ran}" OR NOT written_text STREQUAL "${expected_written}")
        message(FATAL_ERROR "${name}: ran [${ran_text}] wrote [${written_text}], "
                            "expected ran [${expected_ran}] wrote [${expected_written}]\n${out}")
    endif()
    message(STATUS "${name}: ran [${ran_text}] wrote [${written_text}]")
endfunction()

function(replace file from to)
    file(READ "${WORK_DIR}/src/${file}" text)
    string(REPLACE "${from}" "${to}" text "${text}")
    file(WRITE "${WORK_DIR}/src/${file}" "${text}")
endfunction()

execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK_DIR}/build" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE out)
string(REGEX MATCHALL "velorac [A-Za-z]+\\.xaml" ran "${out}")
list(LENGTH ran initial)
if(NOT result EQUAL 0 OR NOT initial EQUAL 4)
    message(FATAL_ERROR "initial build: expected three views and one dictionary check\n${out}")
endif()
message(STATUS "initial build: ran velorac ${initial} times (three views, one dictionary)")

build_step("no change" "" "")
file(TOUCH "${WORK_DIR}/src/Other.xaml")
build_step("touch Other.xaml" "Other.xaml" "")
replace(Other.xaml "Content=\"Go\"" "Content=\"Run\"")
build_step("edit Other.xaml" "Other.xaml" "Other.g.cpp")
# Main uses Chip as a custom control, so it is rechecked; its output does not change.
replace(Chip.xaml "<TextBlock " "<TextBlock FontSize=\"12\" ")
build_step("edit Chip.xaml" "Chip.xaml,Main.xaml" "Chip.g.cpp")
# A merged dictionary: rechecked, and only the view that merges it is regenerated.
replace(Colors.xaml "#FF0078D4" "#FF005A9E")
build_step("edit merged Colors.xaml" "Colors.xaml,Main.xaml" "Main.g.cpp")
file(APPEND "${WORK_DIR}/src/Colors.xaml" "<!-- comment only -->\n")
build_step("comment-only edit of Colors.xaml" "Colors.xaml,Main.xaml" "")
file(APPEND "${WORK_DIR}/src/Controllers.hpp" "// comment only\n")
build_step("comment-only edit of Controllers.hpp" "" "")
replace(Controllers.hpp "    std::string title() const;" "    std::string title() const;\n    rkproperty(Subtitle, std::string, get = subtitle)\n    std::string subtitle() const;")
build_step("new controller property" "Chip.xaml,Main.xaml,Other.xaml" "")
build_step("no change after edits" "" "")

file(READ "${out_dir}/Main.g.d" main_deps)
file(READ "${out_dir}/Other.g.d" other_deps)
if(NOT main_deps MATCHES "Chip.xaml" OR NOT main_deps MATCHES "Controllers.rkmeta" OR NOT main_deps MATCHES "Colors.xaml"
   OR other_deps MATCHES "Chip.xaml" OR other_deps MATCHES "Colors.xaml")
    message(FATAL_ERROR "depfiles do not list exactly the peers used:\n${main_deps}\n${other_deps}")
endif()
message(STATUS "incremental XAML generation: PASS")
