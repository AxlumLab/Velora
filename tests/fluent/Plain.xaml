<Page x:Class="FluentTest.Plain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx-framework:///Themes/WinUIButton.xaml"/>
                <ResourceDictionary Source="ms-appx-framework:///Themes/WinUITextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>
        <Button x:Name="Action" Content="Fluent"/>
        <TextBox x:Name="Input" Text="text"/>
    </StackPanel>
</Page>
