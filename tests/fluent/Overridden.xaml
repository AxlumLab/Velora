<Page x:Class="FluentTest.Overridden"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx-framework:///Themes/WinUIButton.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- The application's own implicit style wins over the framework's, and builds on it. -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="20"/>
            </Style>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF123456"/>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>
        <Button x:Name="Action" Content="Overridden"/>
    </StackPanel>
</Page>
