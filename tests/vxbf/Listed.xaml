<Page x:Class="VxbfTest.Listed"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:VxbfTest">
    <Page.Resources>
        <DataTemplate x:Key="Shouting" x:DataType="local:Person">
            <TextBlock x:Name="Label" Text="{x:Bind Name, Mode=TwoWay}" FontSize="20"/>
        </DataTemplate>
    </Page.Resources>
    <StackPanel>
        <ListView x:Name="People" ItemHeight="20" Height="60" ItemsSource="{x:Bind People}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock x:Name="Label" Text="{Binding Name}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ListView x:Name="Keyed" ItemHeight="20" Height="60" ItemsSource="{x:Bind People}"
                  ItemTemplate="{StaticResource Shouting}"/>
        <ListView x:Name="Once" ItemHeight="20" Height="60" ItemsSource="{x:Bind People}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Person">
                    <TextBlock Text="{x:Bind Name}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Page>
