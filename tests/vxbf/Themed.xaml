<Page x:Class="VxbfTest.Themed"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Shared.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Accent" Color="#FF0078D4"/>
                    <SolidColorBrush x:Key="AccentAlias" Color="{ThemeResource SharedColor}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Accent" Color="#FF60CDFF"/>
                    <SolidColorBrush x:Key="AccentAlias" Color="{ThemeResource SharedColor}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="Accent" Color="#FFFFFF00"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- A reference to a key that is itself a per-theme reference. -->
            <SolidColorBrush x:Key="Outline" Color="{ThemeResource AccentAlias}"/>
            <x:Double x:Key="Big">24</x:Double>
            <Style x:Key="Title" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource Big}"/>
                <Setter Property="Foreground" Value="{ThemeResource Accent}"/>
            </Style>
            <Style x:Key="Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Title}">
                <Setter Property="FontSize" Value="15"/>
            </Style>
            <!-- Implicit: every Button in this page, with its own template instance. -->
            <Style TargetType="Button">
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="Presenter"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ControlTemplate x:Key="Pill" TargetType="Button">
                <Border x:Name="Chrome" CornerRadius="16" Background="{ThemeResource Accent}">
                    <ContentPresenter/>
                </Border>
            </ControlTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel x:Name="Panel">
        <TextBlock x:Name="Heading" Style="{StaticResource Title}" Text="Heading"/>
        <TextBlock x:Name="Sub" Style="{StaticResource Subtitle}" FontSize="11" Text="Sub"/>
        <Button x:Name="First" Content="One" Background="#FF112233" Click="OnClick"/>
        <Button x:Name="Second" Content="Two"/>
        <Button x:Name="Pill" Template="{StaticResource Pill}" Content="Pill"/>
        <Border x:Name="Shared" Background="{ThemeResource AccentAlias}" Padding="{StaticResource SharedPadding}"
                BorderBrush="{ThemeResource Outline}"/>
    </StackPanel>
</Page>
