<Page x:Class="VxbfTest.States"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Hover" Color="#FF005A9E"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Hover" Color="#FF429CE3"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ControlTemplate x:Key="Animated" TargetType="Button">
                <Border x:Name="Chrome" Background="#FF000000" Width="100" Height="40">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualStateGroup.Transitions>
                                <!-- Into Disabled: fade over 0.2 s; everything else jumps. -->
                                <VisualTransition To="Disabled" GeneratedDuration="0:0:0.2"/>
                                <VisualTransition From="Disabled" To="Normal" GeneratedDuration="0:0:0.4">
                                    <VisualTransition.GeneratedEasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </VisualTransition.GeneratedEasingFunction>
                                </VisualTransition>
                            </VisualStateGroup.Transitions>
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Chrome"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="{ThemeResource Hover}" Duration="0:0:0.2"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="Label.Foreground" Value="#FFFFE680"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="Chrome.Opacity" Value="0.4"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="Custom">
                            <VisualState x:Name="Plain"/>
                            <!-- Opacity: a composition property; animating it must not dirty layout. -->
                            <VisualState x:Name="Faded">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity"
                                                     From="0.8" To="0.2" Duration="0:0:0.5"/>
                                </Storyboard>
                            </VisualState>
                            <!-- Key frames: linear to 0.5 at 0.1 s, a jump to 0.3 at 0.2 s, eased to 1 at 0.4 s. -->
                            <VisualState x:Name="Pulse">
                                <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity">
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0.5"/>
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0.3"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn"/>
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <!-- Width: a layout property; animating it measures and arranges again. -->
                            <VisualState x:Name="Wide">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Width"
                                                     To="200" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ContentPresenter x:Name="Label"/>
                </Border>
            </ControlTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>
        <Button x:Name="Target" Template="{StaticResource Animated}" Content="go"/>
    </StackPanel>
</Page>
