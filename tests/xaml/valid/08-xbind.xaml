<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBox Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="{x:Bind ViewModel.Items[0].Title}"/>
    <TextBlock Text="{x:Bind ViewModel.Lookup['key'].Value, Mode=OneWay}"/>
    <TextBlock Text="{x:Bind Format(ViewModel.Count, 'items: {0}', 2, 1.5, true, x:Null)}"/>
    <TextBlock Text="{x:Bind Path=ViewModel.Title, FallbackValue='?'}"/>
  </StackPanel>
</Page>
