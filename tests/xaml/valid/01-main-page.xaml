<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Demo.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Demo">
    <Page.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0078D7"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Velora &amp; Fluent"/>
        <StackPanel Grid.Row="1" Spacing="12">
            <TextBox x:Name="Username" Text="{x:Bind ViewModel.UserName, Mode=TwoWay}"/>
            <Button Content="Save" Click="OnSave" Background="{StaticResource Accent}"/>
        </StackPanel>
    </Grid>
</Page>
