<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{Binding Name, ConverterParameter='a, b = {c}', FallbackValue='it\'s'}"/>
    <TextBlock Text="{Binding Name, ConverterParameter=one\, two}"/>
    <TextBlock Text="{Binding Name, TargetNullValue=two words kept}"/>
    <TextBlock Text="{}{literal braces}"/>
    <TextBlock Text="{Binding Title, ConverterParameter=&quot;quoted&quot;}"/>
  </StackPanel>
</Page>
