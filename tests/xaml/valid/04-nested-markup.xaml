<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextBlock Text="{Binding UserName, Converter={StaticResource NameConverter}, FallbackValue='(none)'}"/>
  <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOffset}"/>
  <Border Background="{ThemeResource ResourceKey=CardBackground}"/>
</Page>
