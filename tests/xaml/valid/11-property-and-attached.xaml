<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <VisualStateManager.VisualStateGroups>
    <VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver">
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.1"/>
        </Storyboard>
      </VisualState>
    </VisualStateGroup>
  </VisualStateManager.VisualStateGroups>
  <Border x:Name="Card" Grid.Row="1">
    <Border.Background>
      <SolidColorBrush Color="#FF0078D4" Opacity="0.5"/>
    </Border.Background>
  </Border>
  <x:Double x:Key="Gap">12</x:Double>
</Grid>
